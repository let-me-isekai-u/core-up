POSTGRES_DB=coreup_db
POSTGRES_USER=coreup_user
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=5432

# Generate a random secret (at least 32 bytes); do not use this placeholder.
Otp__Key=replace_with_a_random_server_secret_at_least_32_bytes
Smtp__Host=localhost
Smtp__Port=1025
Smtp__From=noreply@coreup.local
Smtp__EnableSsl=false

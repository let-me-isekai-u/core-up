  "components": {
    "schemas": {
      "AddWeightRecordRequest": {
        "type": "object",
        "properties": {
          "weightKg": {
            "maximum": 300,
            "minimum": 30,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "accessToken": {
            "type": "string",
            "nullable": true
          },
          "needsProfile": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "BmiCategory": {
        "enum": [
          "Underweight",
          "Normal",
          "Overweight",
          "Obese"
        ],
        "type": "string"
      },
      "ExerciseResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "slug": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "instructions": {
            "type": "string",
            "nullable": true
          },
          "muscleGroup": {
            "type": "string",
            "nullable": true
          },
          "difficulty": {
            "$ref": "#/components/schemas/FitnessLevel"
          },
          "exerciseType": {
            "$ref": "#/components/schemas/ExerciseType"
          },
          "defaultSets": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "defaultReps": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "defaultDurationSeconds": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "defaultRestSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ExerciseType": {
        "enum": [
          "Repetition",
          "Duration"
        ],
        "type": "string"
      },
      "FitnessGoal": {
        "enum": [
          "LoseWeight",
          "Maintain",
          "BuildMuscle"
        ],
        "type": "string"
      },
      "FitnessLevel": {
        "enum": [
          "Beginner",
          "Intermediate",
          "Advanced"
        ],
        "type": "string"
      },
      "Gender": {
        "enum": [
          "Male",
          "Female",
          "Other"
        ],
        "type": "string"
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ProfileRequest": {
        "required": [
          "fullName"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          },
          "heightCm": {
            "maximum": 250,
            "minimum": 100,
            "type": "number",
            "format": "double"
          },
          "weightKg": {
            "maximum": 300,
            "minimum": 30,
            "type": "number",
            "format": "double"
          },
          "targetWeightKg": {
            "maximum": 300,
            "minimum": 30,
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "fitnessLevel": {
            "$ref": "#/components/schemas/FitnessLevel"
          },
          "goal": {
            "$ref": "#/components/schemas/FitnessGoal"
          },
          "trainingDaysPerWeek": {
            "maximum": 7,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "preferredWorkoutDurationMinutes": {
            "maximum": 180,
            "minimum": 10,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          },
          "heightCm": {
            "type": "number",
            "format": "double"
          },

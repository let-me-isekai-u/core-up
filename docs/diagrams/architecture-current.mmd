flowchart TD
    subgraph Mobile[Flutter mobile - presentation and providers]
        UI[MaterialApp - Navigator - screens with Dart parts]
        State[AuthProvider - ProfileProvider - WorkoutProvider]
        Dio[Dio HTTP - Bearer interceptor]
        Secure[FlutterSecureStorage - access token]
        Local[SharedPreferences - onboarding and session mode]
        Guest[Guest catalog and workout in memory]
        UI --> State
        State --> Dio
        State --> Secure
        State --> Local
        State --> Guest
    end
    subgraph Backend[ASP.NET Core API]
        Middleware[Exception middleware - JWT authentication - authorization]
        Controllers[Auth - Profile - Exercises - Plans - Sessions - Weights - Progress]
        App[Application services - DTO validation - rule-based generator]
        Port[IApplicationDbContext - EF Core DbSet abstraction]
        Domain[Domain entities - enums - BMI calculator]
        Infra[Infrastructure - CoreUpDbContext - Npgsql - JWT signing]
        Middleware --> Controllers --> App
        App --> Domain
        App --> Port
        Infra -. implements .-> Port
        Infra --> Domain
    end
    Dio -->|HTTP JSON| Middleware
    Infra --> DB[(PostgreSQL 17 - connection currently unavailable)]
    App --> JWT[IJwtTokenService]
    Infra -. implements .-> JWT

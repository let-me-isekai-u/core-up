@startuml
left to right direction
actor Guest
actor "Authenticated User" as User
rectangle "CoreUp - current mobile and backend" {
  usecase "Register / login with email" as Auth
  usecase "Browse local guest catalog\n(screen exists; shell link missing)" as GuestCatalog
  usecase "Run guest sample workout\n(no persistent progress)" as GuestWorkout
  usecase "Create / update profile\n(update via API only)" as Profile
  usecase "Read profile" as ReadProfile
  usecase "Calculate BMI" as BMI
  usecase "Generate personalized plan" as Generate
  usecase "Read active / historical plans" as Plans
  usecase "Read / filter exercise catalog\n(API; mobile shell link missing)" as Catalog
  usecase "Start workout session" as Start
  usecase "Record exercise completion" as Record
  usecase "Complete / cancel workout\n(cancel via API only)" as Finish
  usecase "Read completed workout history" as History
  usecase "Record body weight" as Weight
  usecase "Read weight history" as ReadWeight
  usecase "Read progress summary" as Progress
  usecase "Local logout" as Logout
}
Guest --> Auth
Guest --> GuestCatalog
Guest --> GuestWorkout
User --> Profile
User --> ReadProfile
User --> Generate
User --> Plans
User --> Catalog
User --> Start
User --> Record
User --> Finish
User --> History
User --> Weight
User --> ReadWeight
User --> Progress
User --> Logout
Profile ..> BMI : <<include>>
Weight ..> BMI : <<include>>
note bottom of Generate
Profile creation calls plan generation after saving profile.
No dated schedule, Google login or administrator role exists.
end note
@enduml

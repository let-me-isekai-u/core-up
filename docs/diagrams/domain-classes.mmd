classDiagram
    class User {
        +Guid Id
        +string Email
        +string PasswordHash
        +DateTime CreatedAt
        +DateTime? UpdatedAt
    }
    class UserProfile {
        +Guid Id
        +Guid UserId
        +string FullName
        +DateOnly? DateOfBirth
        +Gender? Gender
        +decimal HeightCm
        +decimal WeightKg
        +decimal? TargetWeightKg
        +FitnessLevel FitnessLevel
        +FitnessGoal Goal
        +int TrainingDaysPerWeek
        +int PreferredWorkoutDurationMinutes
        +decimal Bmi
        +BmiCategory BmiCategory
        +DateTime CreatedAt
        +DateTime? UpdatedAt
    }
    class Exercise {
        +Guid Id
        +string Name
        +string Slug
        +string? Description
        +string? Instructions
        +string MuscleGroup
        +FitnessLevel Difficulty
        +ExerciseType ExerciseType
        +int? DefaultSets
        +int? DefaultReps
        +int? DefaultDurationSeconds
        +int DefaultRestSeconds
        +string? ImageUrl
        +bool IsActive
        +DateTime CreatedAt
    }
    class WorkoutPlan {
        +Guid Id
        +Guid UserId
        +string Name
        +string? Description
        +FitnessGoal Goal
        +FitnessLevel Difficulty
        +int EstimatedDurationMinutes
        +bool IsActive
        +bool IsGenerated
        +DateTime CreatedAt
        +DateTime? UpdatedAt
    }
    class WorkoutPlanExercise {
        +Guid Id
        +Guid WorkoutPlanId
        +Guid ExerciseId
        +int Order
        +int Sets
        +int? Reps
        +int? DurationSeconds
        +int RestSeconds
        +string? Notes
    }
    class WorkoutSession {
        +Guid Id
        +Guid UserId
        +Guid? WorkoutPlanId
        +DateTime StartedAt
        +DateTime? CompletedAt
        +WorkoutSessionStatus Status
        +int DurationSeconds
        +int TotalExercises
        +int CompletedExercises
        +int TotalSets
        +int CompletedSets
        +int TotalReps
    }
    class WorkoutSessionExercise {
        +Guid Id
        +Guid WorkoutSessionId
        +Guid ExerciseId
        +int Order
        +int TargetSets
        +int CompletedSets
        +int? TargetReps
        +int CompletedReps
        +int? TargetDurationSeconds
        +int CompletedDurationSeconds
        +int RestSeconds
        +bool IsCompleted
    }
    class WeightRecord {
        +Guid Id
        +Guid UserId
        +decimal WeightKg
        +DateTime RecordedAt
    }
    User "1" -- "0..1" UserProfile : profile
    User "1" -- "0..*" WorkoutPlan : owns
    User "1" -- "0..*" WorkoutSession : records
    User "1" -- "0..*" WeightRecord : weighs
    WorkoutPlan "1" -- "0..*" WorkoutPlanExercise : contains
    Exercise "1" -- "0..*" WorkoutPlanExercise : used_in
    WorkoutPlan "0..1" -- "0..*" WorkoutSession : optional_plan
    WorkoutSession "1" -- "0..*" WorkoutSessionExercise : contains
    Exercise "1" -- "0..*" WorkoutSessionExercise : performed_as

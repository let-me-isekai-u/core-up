@page "/admin/users"
@model CoreUp.Api.Pages.Admin.UsersModel
<h1>Tài khoản</h1><form method="get"><input asp-for="Search" placeholder="Username, email hoặc User ID" maxlength="320" aria-label="Tìm tài khoản"/><button>Tìm kiếm</button></form><p>@Model.Total kết quả · Trang @Model.PageNumber</p>
<div class="table"><table><thead><tr><th>Tài khoản</th><th>Email</th><th>Đăng ký UTC</th><th>Vai trò</th><th>Premium</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var u in Model.Rows){<tr><td>@u.Username<br/><small>@u.Id</small></td><td>@u.Email<br/>@(u.EmailVerified ? "Đã xác minh" : "Chưa xác minh")</td><td>@u.CreatedAt.ToString("u")</td><td>@u.Role</td><td>@(u.Premium ? "Active" : "Free")<br/>@u.ExpiresAt?.ToString("u")</td><td><a asp-page="/Admin/User" asp-route-id="@u.Id">Chi tiết / Premium</a></td></tr>}
</tbody></table></div><nav>
@if(Model.PageNumber > 1){<a asp-page="/Admin/Users" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.PageNumber-1)">Trang trước</a>}
@if(Model.PageNumber*25 < Model.Total){<a asp-page="/Admin/Users" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.PageNumber+1)">Trang sau</a>}
</nav>

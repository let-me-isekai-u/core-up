<!doctype html>
<html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Core-Up · Administration</title>
<style>
:root{color-scheme:light;font:16px system-ui;color:#182b42;background:#f4f7fb}body{max-width:1200px;margin:auto;padding:24px}header{display:flex;align-items:center;gap:24px;flex-wrap:wrap;padding:20px 0;border-bottom:1px solid #ccd8e5}a{color:#0863c9}main{padding:24px 0}h1{font-size:30px}section,.card{background:white;padding:24px;border:1px solid #dce4ee;border-radius:14px;margin:16px 0}.stats{display:flex;gap:16px;flex-wrap:wrap}.stats .card{flex:1;min-width:130px}strong.metric{display:block;font-size:32px}table{border-collapse:collapse;width:100%}th,td{padding:12px;text-align:left;border-bottom:1px solid #e1e7ee;vertical-align:top}td{overflow-wrap:anywhere}.table{overflow:auto}input,select,textarea,button{font:inherit;padding:10px;border:1px solid #abbccc;border-radius:6px;max-width:100%;box-sizing:border-box}label{display:block;margin:12px 0}button{background:#0863c9;color:white;cursor:pointer}input[type=checkbox]{margin-right:8px}.error{color:#a51b25}small{color:#526478}pre{white-space:pre-wrap;overflow-wrap:anywhere}nav{display:flex;gap:16px}footer{color:#526478;font-size:13px}
th{background:#edf3fa;font-size:13px;white-space:nowrap}tbody tr:hover{background:#f5faff}.table{background:white;border:1px solid #dce4ee;border-radius:14px;margin:20px 0}code.otp{font-size:24px;font-weight:750;letter-spacing:4px;color:#0759b5;white-space:nowrap}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}.badge{display:inline-block;padding:4px 9px;border-radius:20px;background:#e7f2ff;color:#174f8c;font-size:12px}.muted{color:#60748b;font-size:13px}@@media(max-width:700px){body{padding:12px}header{gap:12px}nav{flex-wrap:wrap}th,td{padding:10px}section{padding:16px}}

body{max-width:none;margin:0;padding:0 28px 24px 260px}header{min-height:64px;justify-content:space-between}header > nav{position:fixed;left:0;top:0;bottom:0;width:208px;padding:28px 16px;flex-direction:column;background:#182b42;z-index:2}header > nav a{color:#eef5ff;padding:12px;border-radius:8px;text-decoration:none}header > nav a:hover,header > nav a:focus-visible{background:#304966}main{max-width:1400px;margin:auto}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid #e89b19;outline-offset:3px}@@media(max-width:800px){body{padding:12px}header > nav{position:static;width:100%;flex-direction:row;flex-wrap:wrap;padding:10px;box-sizing:border-box}header{gap:12px}}
</style></head><body><header><b>CORE-UP / ADMIN</b><nav><a href="/admin">Tổng quan</a><a href="/admin/users">Tài khoản</a><a href="/admin/users?premiumOnly=true">Premium đang hoạt động</a><a href="/admin/requests">Yêu cầu Premium</a><a href="/admin/system">Cấu hình hệ thống</a><a href="/admin/otp">Hộp thư OTP</a><a href="/admin/audit">Nhật ký quản trị</a></nav>
@if (User.Identity?.IsAuthenticated == true) { <span>@User.Identity.Name</span><form method="post" asp-page="/Admin/Logout"><button>Đăng xuất</button></form> }
</header><main>@RenderBody()</main><footer>Quyền Premium demo không phải giao dịch thanh toán. Tất cả thời gian hiển thị là UTC.</footer><dialog id="confirmation" aria-labelledby="confirmation-title"><h2 id="confirmation-title">Xác nhận thao tác nhạy cảm</h2><p id="confirmation-text"></p><button type="button" id="accept">Xác nhận</button> <button type="button" id="cancel">Hủy</button></dialog>
<script>
let pending, submitter;
const modal=document.getElementById('confirmation');
document.querySelectorAll('form[data-sensitive]').forEach(form=>form.addEventListener('submit',event=>{
 if(form.dataset.confirmed==='true') return;
 event.preventDefault(); pending=form; submitter=event.submitter;
 document.getElementById('confirmation-text').textContent=(submitter?.textContent||'Thay đổi')+' cho tài khoản đang hiển thị. Tiếp tục?';modal.showModal();
}));
document.getElementById('cancel').onclick=()=>modal.close();
document.getElementById('accept').onclick=()=>{modal.close();pending.dataset.confirmed='true';pending.requestSubmit(submitter);};
document.querySelectorAll('form').forEach(form=>form.addEventListener('submit',event=>{if(!event.defaultPrevented){form.setAttribute('aria-busy','true');}}));
</script></body></html>

@page "/admin/users/{id:guid}"
@model CoreUp.Api.Pages.Admin.UserModel
<h1>@Model.Account?.Username</h1><section><p>@Model.Account?.Email</p><p>ID: @Model.Account?.Id</p><p>Đăng ký: @Model.Account?.CreatedAt.ToString("u") · @Model.Account?.Role · @(Model.Account?.EmailVerified == true ? "Email đã xác minh" : "Email chưa xác minh")</p>
<h2>Premium: @Model.Access?.Status</h2><p>Nguồn: @(Model.Access?.Source ?? "—") · Hết hạn: @(Model.Access?.ExpiresAt?.ToString("u") ?? (Model.Access?.HasPremium == true ? "Không thời hạn" : "—"))</p></section>
<section><h2>Thay đổi quyền demo</h2><p>Thao tác chỉ ảnh hưởng quyền Premium. Không xóa tài khoản, questionnaire hoặc lịch sử tập.</p>
<form method="post"><div asp-validation-summary="All" class="error"></div><input type="hidden" asp-for="ExpectedRevision"/>
<label>Thời hạn tính từ hiện tại <select asp-for="Duration"><option value="7">7 ngày</option><option value="30">30 ngày</option><option value="180">180 ngày</option><option value="365">365 ngày</option><option value="custom">Tùy chọn UTC</option><option value="forever">Demo không thời hạn (chọn rõ ràng)</option></select></label>
<label>Ngày hết hạn UTC nếu tùy chọn <input asp-for="CustomUtc" type="datetime-local"/></label>
<label><input asp-for="Extend"/> Tôi chủ đích gia hạn quyền đang Active (ngày mới phải muộn hơn ngày hiện có).</label>
<label>Lý do bắt buộc <textarea asp-for="Reason" minlength="3" maxlength="1000" required></textarea></label>
<label><input asp-for="Confirm" required/> Tôi xác nhận thao tác cho @Model.Account?.Username — @Model.Account?.Email — @Model.Account?.Id.</label>
<button name="operation" value="grant">Cấp / gia hạn Premium demo</button>
@if(Model.Entitlement != null && Model.Entitlement.Status != PremiumStatus.Revoked){<button name="operation" value="revoke">Thu hồi Premium</button>}
</form></section>
